DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobsinc"
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port d'écoute de l'API (5000 par défaut)
PORT=5000

# Origines web autorisées (séparées par des virgules).
# En production : l'URL publique du frontend Next.js, ex. https://jobsinc.com
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Mettre à 1 uniquement si l'API tourne derrière un reverse-proxy (nginx…)
TRUST_PROXY=0

# URL publique de l'application (base des liens envoyés par email)
# APP_URL=https://jobsinc.com

# Email transactionnel (SMTP). Laissez vide en développement : les liens
# sont alors journalisés en console (mode [DEV]) et jamais renvoyés dans l'API.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="JOBSINC <no-reply@jobsinc.com>"

# Redis (pour rate-limiting login, cache matching, sessions)
# REDIS_URL=redis://localhost:6379
# REDIS_TLS=false

# Visioconférence (optionnel) : laissez vide = le recruteur fournit son lien Meet.
# Fournisseurs supportés: daily, whereby, google
# VIDEO_PROVIDER=daily
# DAILY_API_KEY=your_daily_api_key
# DAILY_DOMAIN=jobsinc.daily.co
# DAILY_ROOM_PRIVACY=private
# VIDEO_PROVIDER=whereby
# WHEREBY_API_KEY=your_whereby_api_key
# WHEREBY_SUBDOMAIN=jobsinc
# VIDEO_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stockage fichiers (local par défaut; S3 recommandé en prod)
# STORAGE_DRIVER=local
# AWS_S3_BUCKET=jobsinc-uploads
# AWS_S3_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# Sur Vercel le filesystem est éphémère (/tmp) : STORAGE_DRIVER=s3 OBLIGATOIRE en prod Vercel

# FCM — 2 modes (compat Vercel)
# Mode fichier local (dev) :
# FCM_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Mode env var (Vercel, recommandé) : JSON inline ou base64 du serviceAccountKey.json
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Ex: cat serviceAccountKey.json | base64 -w0  -> coller dans Vercel env

# Cron Vercel (sécurise /api/cron/cleanup)
# CRON_SECRET=un-secret-aleatoire-long

# Vercel : NE PAS définir PORT, Vercel gère le port automatiquement
# TRUST_PROXY=1 sera forcé automatiquement si VERCEL=1

# Sécurité
# NODE_ENV=production
# LOG_LEVEL=info