DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobsinc"
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port d'écoute de l'API (5000 par défaut)
PORT=5000

# Origines web autorisées (séparées par des virgules).
# En production : l'URL publique du frontend Next.js, ex. https://jobsinc.com
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Mettre à 1 uniquement si l'API tourne derrière un reverse-proxy (nginx…)
TRUST_PROXY=0

# URL publique de l'application (base des liens envoyés par email)
# APP_URL=https://jobsinc.com

# Email transactionnel (SMTP). Laissez vide en développement : les liens
# sont alors journalisés en console (mode [DEV]) et jamais renvoyés dans l'API.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="JOBSINC <no-reply@jobsinc.com>"

# Redis (pour rate-limiting login, cache matching, sessions)
# REDIS_URL=redis://localhost:6379
# REDIS_TLS=false

# Visioconférence (optionnel) : laissez vide = le recruteur fournit son lien Meet.
# Fournisseurs supportés: daily, whereby, google
# VIDEO_PROVIDER=daily
# DAILY_API_KEY=your_daily_api_key
# DAILY_DOMAIN=jobsinc.daily.co
# DAILY_ROOM_PRIVACY=private
# VIDEO_PROVIDER=whereby
# WHEREBY_API_KEY=your_whereby_api_key
# WHEREBY_SUBDOMAIN=jobsinc
# VIDEO_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=