generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon : le runtime passe par le pooler, les migrations par l'URL directe.
  // `render.yaml` exige déjà DIRECT_URL au démarrage (sans quoi le service ne
  // démarre pas) mais elle n'était câblée nulle part : `migrate deploy`
  // executait son DDL via le pooler.
  directUrl = env("DIRECT_URL")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  passwordHash           String
  role                   Role                @default(CANDIDATE)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tokenVersion           Int                 @default(0)
  emailVerified          Boolean             @default(false)
  candidate              CandidateProfile?
  company                Company?
  candidateConversations Conversation[]      @relation("Candidate")
  createdConversations   Conversation[]      @relation("Creator")
  deviceTokens           DeviceToken[]
  emailVerifications     EmailVerification[]
  receivedMessages       Message[]           @relation("Receiver")
  sentMessages           Message[]           @relation("Sender")
  notifications          Notification[]
  passwordResets         PasswordReset[]
  savedJobs              SavedJob[]
  refreshTokens          RefreshToken[]

  // Index GIN trigram (pg_trgm) : les recherches utilisent `contains`
  // + `mode: 'insensitive'` → ILIKE '%…%', inutilisable avec un B-tree.
  // Déclarés ici pour rester synchronisés avec les migrations manuelles.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
  @@index([createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  firstName        String?
  lastName         String?
  phone            String?
  birthDate        DateTime?
  country          String?
  city             String?
  avatarUrl        String?
  cvUrl            String?
  skills           String?
  experienceYears  Int?
  // Le formulaire de profil candidat (web + mobile) envoie ce champ et
  // `matchingService.scoreEducation` le compare au `Job.educationLevel`.
  // La colonne manquait dans le schéma : Prisma rejetait l'argument
  // (« Unknown argument educationLevel ») et PUT /candidate/profile
  // répondait 500 — donc TOUTE sauvegarde de profil depuis le mobile
  // échouait. Déclarée par la migration 20260925000002.
  educationLevel   String?
  educationField   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  availableFrom    DateTime?
  desiredContracts String?
  applications     Application[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateSkills  CandidateSkill[]
  employments      Employment[]

  // Tri des profils (admin, stats) et recherche trigram.
  @@index([createdAt])
  @@index([updatedAt])
  // Résolution "qui a le droit de lire ce fichier ?" lors du streaming d'un
  // CV ou d'un avatar : la route d'upload est transformée en chemin applicatif
  // et utilisée comme predicate. Sans index, chaque lecture de fichier protégé
  // déclenche un seq scan sur CandidateProfile.
  @@index([cvUrl], map: "CandidateProfile_cvUrl_idx")
  @@index([avatarUrl], map: "CandidateProfile_avatarUrl_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CandidateProfile_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CandidateProfile_lastName_trgm_idx")
  @@index([skills(ops: raw("gin_trgm_ops"))], type: Gin, map: "CandidateProfile_skills_trgm_idx")
}

model Company {
  id          String         @id @default(uuid())
  userId      String         @unique
  name        String
  logo        String?
  description String?
  website     String?
  sector      String?
  size        String?
  country     String?
  city        String?
  address     String?
  foundedYear Int?
  isApproved  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      CompanyImage[]
  employments Employment[]
  faqs        Faq[]
  feedbacks   Feedback[]
  jobs        Job[]

  // Toutes les lectures publiques d'entreprises filtrent par isApproved.
  @@index([isApproved])
  // Index trigram (pg_trgm) pour les recherches `contains`/`insensitive`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
  @@index([sector(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_sector_trgm_idx")
}

model CompanyImage {
  id        String   @id @default(uuid())
  companyId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
}

model Job {
  id                 String        @id @default(uuid())
  companyId          String
  title              String
  description        String
  location           String
  jobType            JobType       @default(INTERNSHIP)
  contractType       String?
  department         String?
  workMode           String?
  experience         String?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?
  deadline           DateTime?
  responsibilities   String?
  skills             String?
  minExperienceYears Int?
  maxExperienceYears Int?
  educationLevel     String?
  isOpen             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  startsAt           DateTime?
  applications       Application[]
  employments        Employment[]
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSkills          JobSkill[]
  savedBy            SavedJob[]

  @@index([companyId])
  @@index([isOpen])
  @@index([createdAt])
  @@index([location])
  @@index([contractType])
  @@index([companyId, isOpen, createdAt])
  // Recherche trigram du catalogue public et de l'administration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_location_trgm_idx")
}

model Application {
  id                 String            @id @default(uuid())
  jobId              String
  candidateProfileId String
  cvUrl              String?
  coverLetter        String?
  status             ApplicationStatus @default(RECEIVED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  candidate          CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversation       Conversation?
  employment         Employment?
  interview          Interview?

  @@unique([jobId, candidateProfileId])
  @@index([candidateProfileId])
  @@index([status])
  @@index([jobId, status])
  // Trends admin + fenêtre d'activité du dashboard entreprise.
  @@index([createdAt])
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String          @unique
  mode          InterviewMode
  status        InterviewStatus @default(PLANIFIE)
  scheduledAt   DateTime?
  duration      Int?
  streamingUrl  String?
  location      String?
  notes         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Entretiens à venir (administration, bannière « en cours »).
  @@index([scheduledAt])
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique
  category        String?
  createdAt       DateTime         @default(now())
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Skill_name_trgm_idx")
}

model CandidateSkill {
  id               String           @id @default(uuid())
  candidateId      String
  skillId          String
  proficiency      Int?             @default(1)
  createdAt        DateTime         @default(now())
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([skillId])
}

model JobSkill {
  id        String   @id @default(uuid())
  jobId     String
  skillId   String
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model Employment {
  id            String           @id @default(uuid())
  applicationId String           @unique
  candidateId   String
  jobId         String
  companyId     String
  position      String
  status        EmploymentStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([companyId])
  @@index([startDate])
}

model Conversation {
  id              String       @id @default(uuid())
  subject         String?
  applicationId   String?      @unique
  companyUserId   String
  candidateUserId String
  lastMessageAt   DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  application     Application? @relation(fields: [applicationId], references: [id])
  candidateUser   User         @relation("Candidate", fields: [candidateUserId], references: [id])
  companyUser     User         @relation("Creator", fields: [companyUserId], references: [id])
  messages        Message[]

  @@unique([companyUserId, candidateUserId])
  @@index([companyUserId, lastMessageAt])
  @@index([candidateUserId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  receiverId     String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receiver       User         @relation("Receiver", fields: [receiverId], references: [id])
  sender         User         @relation("Sender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([receiverId, isRead])
}

model Faq {
  id          String   @id @default(uuid())
  companyId   String
  question    String
  answer      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isPublished])
  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin, map: "Faq_question_trgm_idx")
  @@map("FAQ")
}

model Feedback {
  id          String   @id @default(uuid())
  companyId   String
  author      String
  role        String?
  text        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isPublished])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin, map: "Feedback_text_trgm_idx")
  @@map("Feedback")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum NotificationType {
  APPLICATION
  INTERVIEW
  MESSAGE
  GENERAL
}

enum InterviewMode {
  ONLINE
  PRESENTIEL
}

enum InterviewStatus {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  CANDIDATE
  EMPLOYEE
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  RECEIVED
  UNDER_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
}
