NEXT_PUBLIC_API_URL=https://jobsinc.onrender.com/api
# Pour dev local, surchargez en .env.local :
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# ATTENTION — cette URL est l'unique source de vérité de l'hôte du backend.
# Elle est lue par `lib/api-url.ts`, qui en dérive l'origine, le nom d'hôte
# (pour `images.remotePatterns` et la CSP `img-src`) et l'origine WebSocket.
# Ne la redéfinissez nulle part ailleurs : une divergence ici casse à la fois
# les appels REST, le temps réel et les images cross-origin.

NEXT_PUBLIC_STATS_ENDPOINT=/stats
NEXT_PUBLIC_MATCHING_ENDPOINT=/company/matching
NEXT_PUBLIC_CREATE_JOB_ENDPOINT=/company/jobs
NEXT_PUBLIC_COMPANY_MESSAGES_ENDPOINT=/company/messages

# Optionnels - surcharger selon backend
# NEXT_PUBLIC_COMPANIES_ENDPOINT=/companies
# NEXT_PUBLIC_JOBS_ENDPOINT=/jobs
# NEXT_PUBLIC_SESSION_ENDPOINT=/auth/me
# NEXT_PUBLIC_COMPANY_JOBS_ENDPOINT=/company/jobs
# NEXT_PUBLIC_COMPANY_APPLICATIONS_ENDPOINT=/company/applications
# NEXT_PUBLIC_ADMIN_LOGIN_ENDPOINT=/auth/login/admin
# NEXT_PUBLIC_ADMIN_SESSION_ENDPOINT=/auth/me

# Rôles autorisés à accéder à /admin, séparés par des virgules.
# DOIT correspondre à `enum Role` du schéma Prisma
# (backend/prisma/schema.prisma) : CANDIDATE | EMPLOYEE | RECRUITER | ADMIN.
# Mettre un rôle absent du schéma fait passer `proxy.ts` puis renvoie 403
# côté backend — le compte est admis à la page, puis refusé.
# NEXT_PUBLIC_ADMIN_ROLES=ADMIN

# ---------------------------------------------------------------------------
# Endpoints des ressources Admin
# ---------------------------------------------------------------------------
# Une variable par section de `lib/admin-resources.ts`.
#
# REGLE DE NOMMAGE : `NEXT_PUBLIC_ADMIN_` + le nom de la section SANS
# PONCTUATION, en majuscules, + `_ENDPOINT`.
# C'est ce que fait `section.replace(/[^a-zA-Z]/g, '').toUpperCase()`.
# Donc, section `securityAlerts` -> `NEXT_PUBLIC_ADMIN_SECURITYALERTS_ENDPOINT`
# (PAS `..._SECURITY_ALERTS_...` : le underscore de la section est supprimé).
#
# Ces accès doivent être des membres LITTÉRAUX (`process.env.NEXT_PUBLIC_X`) :
# Next.js n'inline pas les lookups dynamiques `process.env[key]`, ce qui
# rendrait TOUTES les tables /admin/<section> vides sans la moindre erreur.
# La liste est dans `lib/admin-api.ts` (ADMIN_RESOURCE_ENDPOINTS) et
# `tests/adminEndpoints.test.ts` verrouille la synchronisation avec le
# catalogue.
#
# Une section sans variable n'est pas cassée : la page affiche explicitement
# « Endpoint Admin non configuré » au lieu d'un tableau vide sans explication.
#
NEXT_PUBLIC_ADMIN_DASHBOARD_ENDPOINT=/admin/dashboard
NEXT_PUBLIC_ADMIN_USERS_ENDPOINT=/admin/users
NEXT_PUBLIC_ADMIN_CANDIDATES_ENDPOINT=/admin/candidates
NEXT_PUBLIC_ADMIN_EMPLOYEES_ENDPOINT=/admin/employees
NEXT_PUBLIC_ADMIN_COMPANIES_ENDPOINT=/admin/companies
NEXT_PUBLIC_ADMIN_ADMINISTRATORS_ENDPOINT=/admin/administrators
NEXT_PUBLIC_ADMIN_JOBS_ENDPOINT=/admin/jobs
NEXT_PUBLIC_ADMIN_APPLICATIONS_ENDPOINT=/admin/applications
NEXT_PUBLIC_ADMIN_INTERVIEWS_ENDPOINT=/admin/interviews
NEXT_PUBLIC_ADMIN_RECRUITMENTS_ENDPOINT=/admin/recruitments
NEXT_PUBLIC_ADMIN_REPORTS_ENDPOINT=/admin/reports
NEXT_PUBLIC_ADMIN_MODERATION_ENDPOINT=/admin/moderation
NEXT_PUBLIC_ADMIN_ANALYTICS_ENDPOINT=/admin/analytics
NEXT_PUBLIC_ADMIN_ACTIVITY_ENDPOINT=/admin/activity
NEXT_PUBLIC_ADMIN_SESSIONS_ENDPOINT=/admin/sessions
NEXT_PUBLIC_ADMIN_NOTIFICATIONS_ENDPOINT=/admin/notifications
NEXT_PUBLIC_ADMIN_SYSTEM_ENDPOINT=/admin/system
NEXT_PUBLIC_ADMIN_MAINTENANCE_ENDPOINT=/admin/maintenance
NEXT_PUBLIC_ADMIN_TRENDS_ENDPOINT=/admin/trends
NEXT_PUBLIC_ADMIN_REPORTSANALYTICS_ENDPOINT=/admin/reports/analytics
NEXT_PUBLIC_ADMIN_AUDIT_ENDPOINT=/admin/activity/audit
NEXT_PUBLIC_ADMIN_LOGINS_ENDPOINT=/admin/logins
NEXT_PUBLIC_ADMIN_SECURITYALERTS_ENDPOINT=/admin/securityAlerts
NEXT_PUBLIC_ADMIN_CONTENT_ENDPOINT=/admin/content
NEXT_PUBLIC_ADMIN_SEARCH_ENDPOINT=/admin/search

# Note: ne jamais committer .env local avec secrets; seul .env.example est versionné
